{
  "name": "video-ui",
  "private": true,
  "version": "1.0.0",
  "main": "dist-electron/main.js",
  "author": "Your Name",
  "description": "Video Web Application",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test tests/api-errors.test.mjs",
    "preview": "vite preview",
    "electron:dev": "vite --mode electron",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@videojs/http-streaming": "^3.17.0",
    "animate.css": "^4.1.1",
    "artplayer": "^5.3.0",
    "artplayer-plugin-danmuku": "^5.2.0",
    "axios": "^1.10.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.10.2",
    "fabric": "^7.1.0",
    "hls.js": "^1.6.15",
    "js-cookie": "^3.0.5",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.3",
    "sass": "^1.89.2",
    "socket.io-client": "^4.8.3",
    "spark-md5": "^3.0.2",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1",
    "vue-upload-component": "^2.8.23",
    "wavesurfer.js": "^7.12.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^7.0.0",
    "vite-plugin-electron": "^0.29.0"
  },
  "build": {
    "appId": "com.video.app",
    "productName": "Video App",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
