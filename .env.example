# 复制为项目根目录的 .env，再填写本机或团队分配的值。
# .env 已被 Git 忽略，禁止把真实值提交到仓库。

# Django：生产环境必须使用随机、独立的值。
DJANGO_SECRET_KEY=change_me_for_local_development

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=video_platform
MYSQL_USER=root
MYSQL_PASSWORD=

# Redis：默认使用 DB 0 作为 Celery broker/result backend。
# 密码中如果包含 @、:、/ 等 URL 特殊字符，需要先进行 URL 编码。
REDIS_URL=redis://:change_me@127.0.0.1:6379/0

# 可选：不配置时会根据 REDIS_URL 自动使用 DB 1/2。
# REDIS_CACHE_URL=redis://:change_me@127.0.0.1:6379/1
# REDIS_CHANNEL_URL=redis://:change_me@127.0.0.1:6379/2
# CELERY_BROKER_URL=redis://:change_me@127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://:change_me@127.0.0.1:6379/0

# DeepSeek。未配置时相关 AI 功能不能正常调用。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 邮件（默认使用控制台后端；需要发邮件时再配置 SMTP）
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=465
# EMAIL_USE_SSL=true
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@example.com
# SITE_NAME=Video Platform

# 支付宝沙箱（需要支付功能时配置；私钥内容使用 \n 表示换行）
# ALIPAY_APPID=
# ALIPAY_APP_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_DEBUG=true
# ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# ALIPAY_RETURN_URL=http://localhost:5173/user/vip/return
# ALIPAY_NOTIFY_URL=http://localhost:8000/api/users/vip/notify/
