# 复制为项目根目录的 .env，再填写本机或团队分配的值。
# .env 已被 Git 忽略，禁止把真实值提交到仓库。

# Django：生产环境必须使用随机、独立的值。
DJANGO_SECRET_KEY=change_me_for_local_development

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=video_platform
MYSQL_USER=root
MYSQL_PASSWORD=

# Redis：默认使用 DB 0 作为 Celery broker/result backend。
# 密码中如果包含 @、:、/ 等 URL 特殊字符，需要先进行 URL 编码。
REDIS_URL=redis://:change_me@127.0.0.1:6379/0

# 可选：不配置时会根据 REDIS_URL 自动使用 DB 1/2。
# REDIS_CACHE_URL=redis://:change_me@127.0.0.1:6379/1
# REDIS_CHANNEL_URL=redis://:change_me@127.0.0.1:6379/2
# CELERY_BROKER_URL=redis://:change_me@127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://:change_me@127.0.0.1:6379/0
# 使用共享 Redis 时，每套开发环境必须设置不同的队列名。
CELERY_TASK_DEFAULT_QUEUE=video_dev_local

# AI Provider。未配置云端密钥时，基础视频业务仍可运行，相关 AI 功能会明确提示未启用。
AI_TEXT_PROVIDER=deepseek
AI_ASR_PROVIDER=disabled
AI_OCR_PROVIDER=disabled
AI_MODERATION_PROVIDER=disabled
AI_STORAGE_PROVIDER=local
AI_PROVIDER_TIMEOUT_SECONDS=60
AI_PROVIDER_MAX_RETRIES=2
AI_TEXT_MAX_INPUT_CHARS=50000
AI_CLOUD_MAX_INPUT_BYTES=2147483648
AI_OCR_SAMPLE_COUNT=8

# DeepSeek：字幕翻译/优化、摘要和标签。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 阿里云百炼：长音视频字幕转写。
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=beijing
# 百炼工作空间专属域名，例如：https://<workspace-id>.cn-beijing.maas.aliyuncs.com
DASHSCOPE_BASE_URL=
DASHSCOPE_ASR_MODEL=fun-asr
DASHSCOPE_POLL_INTERVAL_SECONDS=10
DASHSCOPE_POLL_TIMEOUT_SECONDS=1500
AI_AUDIO_EXTRACT_TIMEOUT_SECONDS=900

# 阿里云 OpenAPI/OSS。正式环境优先使用 RAM 角色或 STS 临时凭据。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# ALIBABA_CLOUD_SECURITY_TOKEN=

# OSS 仅作为云端 AI 的临时文件交换层，Bucket 必须保持私有。
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_PREFIX=ai-temp/
ALIYUN_OSS_SIGNED_URL_TTL_SECONDS=21600
ALIYUN_OSS_TEMP_RETENTION_HOURS=24

# 阿里云 OCR 通用文字识别；AI_OCR_PROVIDER=aliyun 时才会调用。
ALIYUN_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com
ALIYUN_OCR_MAX_IMAGE_BYTES=10485760

# 阿里云内容安全视频审核；AI_MODERATION_PROVIDER=aliyun 时才会调用。
ALIYUN_GREEN_REGION=cn-shanghai
ALIYUN_GREEN_ENDPOINT=green-cip.cn-shanghai.aliyuncs.com
ALIYUN_VIDEO_MODERATION_SERVICE=videoDetection
ALIYUN_MODERATION_POLL_INTERVAL_SECONDS=15
ALIYUN_MODERATION_POLL_TIMEOUT_SECONDS=1800
AI_MODERATION_FRAME_EXTRACT_TIMEOUT_SECONDS=30

# 邮件（默认使用控制台后端；需要发邮件时再配置 SMTP）
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=465
# EMAIL_USE_SSL=true
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@example.com
# SITE_NAME=Video Platform

# 支付宝沙箱（需要支付功能时配置；私钥内容使用 \n 表示换行）
# ALIPAY_APPID=
# ALIPAY_APP_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_DEBUG=true
# ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# ALIPAY_RETURN_URL=http://localhost:5173/user/vip/return
# ALIPAY_NOTIFY_URL=http://localhost:8000/api/users/vip/notify/
